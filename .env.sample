# Copie para .env (git-ignored) e preencha só o que for usar.
# Nada aqui é obrigatório: sem chave nenhuma o app roda inteiro e os e-mails
# aparecem em http://localhost:3000/dev/mails.

# --- E-mail -------------------------------------------------------------------

# Resend (https://resend.com/api-keys). Presente => e-mails saem de verdade,
# em qualquer ambiente. Ausente => letter_opener_web em dev, :test em teste.
RESEND_API_KEY=

# Remetente. No Resend precisa ser de um domínio verificado na conta.
MAIL_FROM="Trello Clone <no-reply@localhost>"

# --- App ----------------------------------------------------------------------

# Host usado para montar os links dos e-mails em produção.
APP_HOST=localhost
